<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Obligatorio aqui, no solo en los manifests de debug/profile.
         Flutter declara INTERNET en esos dos porque su tooling lo necesita
         para hablar con la app, pero NO los mezcla en el build de release:
         sin esta linea el APK de release se queda sin red y toda peticion
         falla con "Failed host lookup", como si no hubiera internet. No se
         nota hasta el primer build de release. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Desde Android 13 las notificaciones necesitan permiso explicito, y
         ademas hay que pedirlo en tiempo de ejecucion (lo hace
         PushService.registerCurrentDevice). Sin esto no llega ninguna
         notificacion y tampoco salta ningun error: simplemente no suena. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="MatchPoint"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Icono de la barra de estado. Android lo pinta monocromo a 24 dp:
             sin declararlo, aplasta el del lanzador y sale una mancha blanca.
             Es la silueta del logo (circulo partido), no la raqueta con la
             zapatilla — dos objetos a ese tamaño no se resuelven. Lo genera
             tool/gen_app_icon.dart en las cinco densidades. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- Y el color con el que se tiñe: el verde pista de la app, en vez
             del gris por defecto del sistema. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

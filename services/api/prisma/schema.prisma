generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  matchesA      Match[]        @relation("MatchesA")
  matchesB      Match[]        @relation("MatchesB")
  preferences   Preferences?
  profile       Profile?
  refreshTokens RefreshToken[]
  swipesFrom    Swipe[]        @relation("SwipesFrom")
  swipesTo      Swipe[]        @relation("SwipesTo")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  birthDate   DateTime
  city        String?
  bio         String?
  photos      String[] @default([])
  sports      Sport[]  @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preferences {
  id               String   @id @default(uuid())
  userId           String   @unique
  sportsWanted     Sport[]  @default([])
  distanceKm       Int      @default(25)
  ageMin           Int      @default(18)
  ageMax           Int      @default(60)
  genderPreference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Swipe {
  id         String    @id @default(uuid())
  fromUserId String
  toUserId   String
  sport      Sport
  type       SwipeType
  createdAt  DateTime  @default(now())
  fromUser   User      @relation("SwipesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User      @relation("SwipesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId, sport])
  @@index([toUserId, sport])
}

model Match {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  sport     Sport
  createdAt DateTime @default(now())
  userA     User     @relation("MatchesA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("MatchesB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId, sport])
  @@index([userAId])
  @@index([userBId])
}

enum Sport {
  TENNIS
  RUNNING
}

enum SwipeType {
  LIKE
  PASS
}

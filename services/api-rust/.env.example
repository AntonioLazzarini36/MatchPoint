# Copia esto a `.env` para desarrollo local. Los valores de abajo son los
# de dev y sirven tal cual: `docker compose up -d db` + `cargo run`.
#
# ⚠️ En un despliegue real hay que cambiarlos TODOS. Con APP_ENV=production
# el proceso se niega a arrancar si detecta estos valores de ejemplo, un
# CORS abierto o un PUBLIC_BASE_URL apuntando a localhost (ver
# `AppConfig::validate` en src/config.rs).

# development | production
APP_ENV=development

DATABASE_URL="postgresql://matchpoint:matchpoint@127.0.0.1:5432/matchpoint"
PORT=3000

# Genéralos con: openssl rand -base64 48
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Clave AES-256 de los mensajes del chat. Genérala con:
#   openssl rand -base64 32
# ⚠️ Cambiarla deja ILEGIBLES todos los mensajes ya guardados: se cifran
# con ella y no hay forma de recuperarlos.
MESSAGE_KEY_BASE64="1mKQdNgaRWyt/45tyC5TKw9ogvCE45Kq5p+wciokGtg="

# Dónde se guardan las fotos subidas y con qué base se construyen sus URLs
# públicas. En un contenedor sin volumen persistente, PHOTOS_DIR se borra
# en cada despliegue — hay que montar un volumen o mover esto a
# almacenamiento de objetos antes de tener usuarios de verdad.
PHOTOS_DIR="./uploads"
PUBLIC_BASE_URL="http://localhost:3000"

# Orígenes permitidos por CORS, separados por comas. Vacío = cualquiera,
# que es lo cómodo en dev (Flutter web usa un puerto distinto cada vez).
# Ejemplo en producción: CORS_ALLOWED_ORIGINS="https://matchpoint.app"
CORS_ALLOWED_ORIGINS=""

# Activar SÓLO si hay un proxy/balanceador delante (Fly, Railway, nginx...).
# Hace que el rate limiter lea X-Forwarded-For en vez de la IP de la
# conexión TCP. Sin proxy delante, activarlo permite saltarse el límite
# inventando una IP en cada petición.
TRUST_PROXY=false

# Envío de correo (códigos de verificación de email).
# Sin RESEND_API_KEY los correos NO se envían: se escriben en el log con el
# código bien visible, que es lo que permite desarrollar y probar el flujo
# entero sin credenciales. Con APP_ENV=production, faltar aquí aborta el
# arranque — para que nadie despliegue creyendo que manda correos.
#
# EMAIL_FROM es el REMITENTE, no tu correo personal. Sin un dominio
# verificado en Resend el único remitente permitido es onboarding@resend.dev,
# y sólo se puede enviar al email con el que creaste la cuenta de Resend.
RESEND_API_KEY=""
EMAIL_FROM="MatchPoint <onboarding@resend.dev>"

# Notificaciones push (FCM). Mismo criterio que el correo: sin esto las
# notificaciones NO se envían, se escriben en el log, y todo el flujo se
# puede desarrollar y probar sin credenciales.
#
# Es el JSON de una cuenta de servicio de Firebase (Configuración del
# proyecto -> Cuentas de servicio -> Generar nueva clave privada). Se acepta
# tal cual O en base64; **usa base64**: el JSON lleva la clave privada con
# saltos de línea reales y pegarlo en el panel de Railway o en un .env se
# rompe con facilidad, quedándose en la primera línea.
#
#   base64 -w0 tu-clave.json
#
# ES UN SECRETO DE VERDAD: da control sobre el proyecto de Firebase. No lo
# metas en el repo ni lo pegues en un chat.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Pedir verificación de email al registrarse. Apagarlo NO borra nada: los
# endpoints siguen ahí pero responden 503, y la app esconde la pantalla en
# vez de llevar a la gente a un error.
#
# Ponlo a false mientras no tengas un dominio de correo verificado: sin él,
# Resend sólo entrega al email del titular de la cuenta, así que cualquier
# otra persona que se registre chocaría contra un fallo de envío nada más
# crear su cuenta. Con dominio verificado, vuelve a true.
EMAIL_VERIFICATION_ENABLED=true
